  "run_id": "41dfaa7b4aa8",
  "job_id": "275b48a6dd2f",
  "user_id": null,
  "api_key_id": null,
  "spec": {
    "code": "\nfrom skidl import *\n\n# Power rails\nvin = Net(\"VIN\"); vin.drive = POWER\nv3v3 = Net(\"+3V3\"); v3v3.drive = POWER\ngnd = Net(\"GND\"); gnd.drive = POWER\n\n# Internal signal nets\nsda_3v3 = Net(\"SDA_3V3\")\nscl_3v3 = Net(\"SCL_3V3\")\nsda_host = Net(\"SDA\")\nscl_host = Net(\"SCL\")\nirq_net = Net(\"IRQ\")\n\n# Electrode nets\nele_nets = [Net(f\"ELE{i}\") for i in range(12)]\n\n# ==============================================================\n# 3.3V LDO Regulator (TLV70033, SOT-23-5)\n# ==============================================================\nreg = Part(\"Regulator_Linear\", \"TLV70033_SOT23-5\",\n           footprint=\"Package_TO_SOT_SMD:SOT-23-5\")\nreg[\"IN\"] += vin\nreg[\"GND\"] += gnd\nreg[\"OUT\"] += v3v3\nreg[\"EN\"] += vin\nreg[\"NC\"] += NC()\n\n# LDO decoupling caps\ncin = Part(\"Device\", \"C\", value=\"1uF\",\n           footprint=\"Capacitor_SMD:C_0603_1608Metric\")\ncin[1] += vin; cin[2] += gnd\n\ncout = Part(\"Device\", \"C\", value=\"1uF\",\n            footprint=\"Capacitor_SMD:C_0603_1608Metric\")\ncout[1] += v3v3; cout[2] += gnd\n\n# Bulk cap on 3V3 (10uF)\ncbulk = Part(\"Device\", \"C\", value=\"10uF\",\n             footprint=\"Capacitor_SMD:C_0805_2012Metric\")\ncbulk[1] += v3v3; cbulk[2] += gnd\n\n# ==============================================================\n# MPR121QR2 (LCSC C91322, QFN-20 3x3mm 0.4mm pitch)\n# Using KiCad standard UQFN-20 footprint (3x3mm, P0.4mm)\n# Pins: ~{IRQ}(1), SCL(2), SDA(3), ADDR(4), VREG(5), VSS(6),\n#       REXT(7), ELE0-ELE11(8-19), VDD(20)\n# ==============================================================\nic = Part(\"C91322\", \"MPR121QR2\",\n          footprint=\"Package_DFN_QFN:UQFN-20_3x3mm_P0.4mm\")\n\nic[\"VDD\"] += v3v3\nic[\"VSS\"] += gnd\nic[\"~{IRQ}\"] += irq_net\nic[\"SCL\"] += scl_3v3\nic[\"SDA\"] += sda_3v3\n\n# ADDR to GND = I2C address 0x5A\nr_addr = Part(\"Device\", \"R\", value=\"0R\",\n              footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_addr[1] += ic[\"ADDR\"]\nr_addr[2] += gnd\n\n# VREG bypass cap (MPR121 internal regulator output)\ncvreg = Part(\"Device\", \"C\", value=\"10nF\",\n             footprint=\"Capacitor_SMD:C_0603_1608Metric\")\ncvreg[1] += ic[\"VREG\"]\ncvreg[2] += gnd\n\n# REXT: 200k to GND (sets charge current per datasheet)\nr_rext = Part(\"Device\", \"R\", value=\"200K\",\n              footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_rext[1] += ic[\"REXT\"]\nr_rext[2] += gnd\n\n# VDD decoupling 100nF\ncdec = Part(\"Device\", \"C\", value=\"100nF\",\n            footprint=\"Capacitor_SMD:C_0603_1608Metric\")\ncdec[1] += v3v3\ncdec[2] += gnd\n\n# Electrode connections ELE0-ELE11\nfor i in range(12):\n    ic[f\"ELE{i}\"] += ele_nets[i]\n\n# ==============================================================\n# I2C Bidirectional Level Shifter (2x BSS138 N-MOSFET)\n# Gate tied to 3V3, Source on low (3V3) side, Drain on high (VIN) side\n# ==============================================================\nq_sda = Part(\"Transistor_FET\", \"BSS138\",\n             footprint=\"Package_TO_SOT_SMD:SOT-23\")\nq_sda[\"G\"] += v3v3\nq_sda[\"S\"] += sda_3v3\nq_sda[\"D\"] += sda_host\n\nr_sda_lo = Part(\"Device\", \"R\", value=\"10K\",\n                footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_sda_lo[1] += v3v3; r_sda_lo[2] += sda_3v3\n\nr_sda_hi = Part(\"Device\", \"R\", value=\"10K\",\n                footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_sda_hi[1] += vin; r_sda_hi[2] += sda_host\n\nq_scl = Part(\"Transistor_FET\", \"BSS138\",\n             footprint=\"Package_TO_SOT_SMD:SOT-23\")\nq_scl[\"G\"] += v3v3\nq_scl[\"S\"] += scl_3v3\nq_scl[\"D\"] += scl_host\n\nr_scl_lo = Part(\"Device\", \"R\", value=\"10K\",\n                footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_scl_lo[1] += v3v3; r_scl_lo[2] += scl_3v3\n\nr_scl_hi = Part(\"Device\", \"R\", value=\"10K\",\n                footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_scl_hi[1] += vin; r_scl_hi[2] += scl_host\n\n# ==============================================================\n# IRQ Pull-up + LED indicator\n# MPR121 IRQ is active-low open drain\n# LED: anode->3V3 via R_LED, cathode->IRQ (lights when IRQ is low)\n# LED K=pin1, A=pin2\n# ==============================================================\nr_irq = Part(\"Device\", \"R\", value=\"100K\",\n             footprint=\"Resistor_SMD:R_0603_1608Metric\")\nr_irq[1] += v3v3\nr_irq[2] += irq_net\n\nr_led = Part(\"Device\", \"R\", value=\"1K\",\n             footprint=\"Resistor_SMD:R_0603_1608Metric\")\nled = Part(\"Device\", \"LED\", value=\"RED\",\n           footprint=\"LED_SMD:LED_0603_1608Metric\")\n\nr_led[1] += v3v3\nr_led[2] += led[\"A\"]   # Anode to current-limit resistor\nled[\"K\"] += irq_net    # Cathode to IRQ (lit when pulled low)\n\n# ==============================================================\n# Connectors\n# ==============================================================\n# Host header (1x5): VIN, GND, SDA, SCL, IRQ\nj_host = Part(\"Connector\", \"Conn_01x05_Pin\",\n              value=\"HOST_I2C\",\n              footprint=\"Connector_PinHeader_2.54mm:PinHeader_1x05_P2.54mm_Vertical\")\nj_host[\"Pin_1\"] += vin\nj_host[\"Pin_2\"] += gnd\nj_host[\"Pin_3\"] += sda_host\nj_host[\"Pin_4\"] += scl_host\nj_host[\"Pin_5\"] += irq_net\nj_host.edge_preference = \"left\"\n\n# Electrode header (1x12): ELE0-ELE11\nj_ele = Part(\"Connector\", \"Conn_01x12_Pin\",\n             value=\"ELECTRODES\",\n             footprint=\"Connector_PinHeader_2.54mm:PinHeader_1x12_P2.54mm_Vertical\")\nfor i in range(12):\n    j_ele[f\"Pin_{i+1}\"] += ele_nets[i]\nj_ele.edge_preference = \"right\"\n",
    "_mode": "skidl_python",
    "board_name": "board",
    "outline_mm": null,
    "design_intent": "",
    "kicad_version": "9",
    "pipeline_goal": "manufacturing",
    "assembly_policy": "single_sided",
    "corner_radius_mm": null,
    "custom_footprints": null
  },
